# ===== DATABASE =====
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/mnstudio
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mnstudio
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# ===== SERVER =====
PORT=5000
NODE_ENV=development

# JWT secret (mínimo 32 caracteres, use algo seguro)
JWT_SECRET=sua-chave-secreta-super-segura-minimo-32-caracteres-aqui

# Tempo de expiração do JWT (ex: 7d, 24h)
JWT_EXPIRE=7d

# ===== FRONTEND =====
# URL do frontend para CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ===== GOOGLE OAUTH (Opcional) =====
# Obtenha em: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# Google OAuth Sub para validação de tokens
GOOGLE_SUB=seu-google-sub

# ===== EMAIL (Opcional) =====
# SMTP para enviar emails (verificação, reset de senha)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
SMTP_FROM=noreply@mnstudio.com
SMTP_FROM_NAME=MN Studio
SMTP_SECURE=false

# ===== IA (Opcional) =====
# OpenAI API Key para geração de texto
OPENAI_API_KEY=sk-seu-api-key-aqui

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-seu-api-key-aqui

# Google Generative AI (Gemini)
GOOGLE_API_KEY=AIzaSy-seu-api-key-aqui

# Groq API
GROQ_API_KEY=gsk_seu-api-key-aqui

# Deepseek API
DEEPSEEK_API_KEY=sk-seu-api-key-aqui

# ===== LOGGING =====
LOG_LEVEL=debug
# debug, info, warn, error

# ===== ARQUIVO UPLOAD =====
# Tamanho máximo de upload em bytes (10MB = 10485760)
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ===== OUTROS =====
# URL base da API (para links em emails, etc)
API_BASE_URL=http://localhost:5000

# Ambiente de execução
APP_ENV=development

# Modo debug
DEBUG=false
