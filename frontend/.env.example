# ===== API =====
# URL base da API backend
VITE_API_URL=http://localhost:5000/api

# ===== APP INFO =====
# Nome da aplicação
VITE_APP_NAME=MN Studio

# Versão
VITE_APP_VERSION=1.0.0

# ===== GOOGLE OAUTH =====
# Obtenha ID em: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# ===== FEATURES =====
# Ativar/desativar features
VITE_ENABLE_2FA=true
VITE_ENABLE_COINS=true
VITE_ENABLE_BADGES=true
VITE_ENABLE_WORLDBUILDING=true
VITE_ENABLE_AI_FEATURES=false

# ===== ANALYTICS (Opcional) =====
VITE_GOOGLE_ANALYTICS_ID=

# ===== LINKS ÚTEIS =====
VITE_PRIVACY_URL=/privacy
VITE_TERMS_URL=/terms
VITE_CONTACT_EMAIL=contato@mnstudio.com

# ===== THEME =====
# Tema padrão: light, dark, auto
VITE_DEFAULT_THEME=auto

# ===== PAGINATION =====
# Itens por página padrão
VITE_DEFAULT_LIMIT=20

# ===== READER IMAGES =====
# Imagens fallback para o leitor de mangás
VITE_READER_FALLBACK_IMAGE=/images/reader/reader-page-error.png
VITE_READER_LOADING_IMAGE=/images/reader/reader-loading.png
VITE_READER_EMPTY_IMAGE=/images/reader/reader-empty.png
VITE_READER_END_IMAGE=/images/reader/reader-end.png
